# Hypixel API key for fetching data. You can get one from https://developer.hypixel.net/
HYPIXEL_API_KEY=""
# Discord webhook URL for sending notifications & errors
DISCORD_WEBHOOK=""

# Whether to enable development mode. When true, processed route responses bypass RAM and Redis caching;
# raw upstream API data caches remain enabled.
DEV="true"

# Whether to enable armor hex color rendering (Got disabled because of mass scraping issues, might get re-enabled in the future
ENABLE_ARMOR_HEX="false"
# Whether to enable verbose logging for debugging purposes (set to "true" to enable)
VERBOSE_LOGGING="true"
# Whether to enable forensics features (e.g., tracking bottlenecks, logging detailed request info, etc.)
FORENSICS_ENABLED="true"

# Domain for the application (used for rendering images, resourcepacks, etc.)
DOMAIN="http://localhost:8080"

# Commit hash for source/license metadata exposed at /api/source
SOURCE_COMMIT=""

# Port to listen on (default 8080)
# PORT="8080"

# PostgreSQL store for the last good Hypixel/Mojang data (outage fallback, cache-only API keys, leaderboards).
# Leave empty to disable it.
DATABASE_URL="postgres://skycrypt:DEV@localhost:5432/skycrypt_backend"
# Most the backend database may use, in GB. Least recently used data is evicted to stay under it.
STORAGE_LIMIT_GB="50"
# How many entries each leaderboard keeps (default 1000). Changing it rebuilds the boards.
LEADERBOARD_SIZE="1000"

# Redis connection
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_MAXMEMORY="8gb"
# volatile-lfu: only keys with a TTL (caches) are evicted, so leaderboards stay
REDIS_MAXMEMORY_POLICY="volatile-lfu"

# Server API token for authentication
SERVER_API_TOKEN="DUCKYSOLUCKY" # Must match the token in the frontend config
# Frontend origin the backend can reach, used to verify API keys and report their usage
FRONTEND_INTERNAL_URL="http://localhost:5173"
DISABLE_SERVER_API_AUTH="true" # Set to true to disable API token authentication (for development only, not recommended for production)
